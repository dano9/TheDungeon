{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "eded9e849f1b4aed86f55cbf4194c947",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetOverlayUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1819.0,
            "y": 155.00001525878907,
            "width": 236.0,
            "height": 326.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "cf7961968042456c8108d42bcbd63b73"
        },
        {
            "m_Id": "701b5ca3e13641de8927b8a333207fb2"
        },
        {
            "m_Id": "3bc0a3f182b24346939777df96fd6e42"
        },
        {
            "m_Id": "ea97177c5e744905b23f0e090ffa6d19"
        },
        {
            "m_Id": "bc6671f4fcf24eb6ba956d90f0767f5f"
        },
        {
            "m_Id": "8080af208a7043be96df91f6860c546b"
        },
        {
            "m_Id": "f5b2c2c3873349b8af43800da57fedd3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetOverlayUV",
    "m_FunctionSource": "",
    "m_FunctionBody": "OverlayUVA = SpritePosition + UVLTS;\nOverlayUVA.y = SpritePosition.y + (SpriteSize.y-UVLTS.y);\n\nOverlayAlphaA=0.5;\n\nfloat2 mags = (UVLTS/SpriteSize);\nOverlayAlphaA = mags.y;\n\nOverlayUVB = SpritePosition + UVLTS;\nOverlayAlphaB=1-OverlayAlphaA;"
}

